# Copy to .env.local and adjust. Never commit real secrets (ADR 0004).
# Validated in src/lib/env.ts (public) and src/lib/env.server.ts (server-only).

# --- Public (browser-safe) values ---
# Local Supabase API URL (local only, not a secret).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local anon/publishable key: copy it from `supabase status` once the local
# stack runs (local only, not a secret). Replace the placeholder.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only values (never prefix with NEXT_PUBLIC_) ---
# Required in development and test, optional in production until a cloud
# database exists.
# Runtime connection as the fail-closed role app_backend (ADR 0003). The role
# is created by a migration (FND-T-11); the local password is set in supabase/seed.sql (local only, not a secret; the cloud password differs and is set manually).
DATABASE_URL=postgresql://app_backend:app_backend_local_password@127.0.0.1:54322/postgres
# Tooling only (Supabase CLI, drizzle-kit pull). Role postgres; local Supabase
# default password: local only, not a secret. Never set on Vercel.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
