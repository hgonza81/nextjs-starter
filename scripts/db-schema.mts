/**
 * `pnpm db:schema`: regenerates the Drizzle schema mirror from the local
 * database (FND-FR-07, ADR 0002). Run it after `pnpm db:reset`.
 *
 * Requires `DATABASE_MIGRATION_URL` (set it in `.env.local`, see
 * `.env.example`, or export it). It is validated BEFORE anything is touched,
 * and the previous generated files are restored if `drizzle-kit pull` fails,
 * so a failed run never leaves tracked files deleted.
 *
 * `drizzle-kit pull` also writes a randomly named `0000_*.sql` file and a
 * `meta/` folder (an introspection "migration" that must never be applied).
 * They are removed here so the output is stable: running this twice yields an
 * empty `git diff`. Only `schema.ts` and `relations.ts` are kept, each marked
 * as generated. `index.ts` in the same folder is hand-written and untouched.
 *
 * The `.mts` extension makes Node treat the file as an ES module without a
 * MODULE_TYPELESS_PACKAGE_JSON warning (the package has no `"type"`).
 */
import { execFileSync } from "node:child_process";
import { readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const SCHEMA_DIR = join(import.meta.dirname, "..", "src", "db", "schema");
const GENERATED_FILES = ["schema.ts", "relations.ts"] as const;
const HEADER =
  "// GENERATED by `pnpm db:schema` (drizzle-kit pull). Do not edit.\n" +
  "// Source of truth: supabase/migrations (ADR 0002).\n";

function failWith(message: string): never {
  console.error(`db:schema: ${message}`);
  process.exit(1);
}

function assertMigrationUrlIsUsable(): void {
  const hint =
    "Copy .env.example to .env.local (or export the variable) and run `pnpm db:start` first.";
  const value = process.env.DATABASE_MIGRATION_URL;
  if (value === undefined || value === "") {
    failWith(`DATABASE_MIGRATION_URL is not set. ${hint}`);
  }
  let protocol: string;
  try {
    protocol = new URL(value).protocol;
  } catch {
    failWith(`DATABASE_MIGRATION_URL is not a valid URL. ${hint}`);
  }
  if (protocol !== "postgresql:" && protocol !== "postgres:") {
    failWith(`DATABASE_MIGRATION_URL must be a postgresql:// URL. ${hint}`);
  }
}

function removeGeneratedOutput(): void {
  for (const entry of readdirSync(SCHEMA_DIR)) {
    if (entry.endsWith(".sql") || entry === "meta") {
      rmSync(join(SCHEMA_DIR, entry), { recursive: true });
    }
  }
}

assertMigrationUrlIsUsable();

const previousContents = GENERATED_FILES.map((file) => ({
  path: join(SCHEMA_DIR, file),
  content: readFileSync(join(SCHEMA_DIR, file), "utf8"),
}));

try {
  removeGeneratedOutput();
  for (const { path } of previousContents) {
    rmSync(path, { force: true });
  }

  // Throws when drizzle-kit fails, e.g. database unreachable.
  execFileSync("pnpm", ["exec", "drizzle-kit", "pull"], { stdio: "inherit" });

  removeGeneratedOutput();
  for (const { path } of previousContents) {
    writeFileSync(path, HEADER + readFileSync(path, "utf8"));
  }
} catch (error) {
  removeGeneratedOutput();
  for (const { path, content } of previousContents) {
    writeFileSync(path, content);
  }
  console.error("db:schema: failed; previous generated files were restored.");
  throw error;
}
